{
  "name": "adam",
  "version": "1.4.0",
  "description": "Adam, an Apple Music desktop client for Linux and Windows",
  "license": "MIT",
  "main": "main.mjs",
  "type": "module",
  "engines": {
    "electron": "^43.0.0"
  },
  "allowScripts": {
    "abstract-socket@2.1.1": true
  },
  "scripts": {
    "dist": "npm run build:drm && npm run build:go && npm run build:engine && npm run build:vlc && electron-builder --linux AppImage",
    "postdist": "rm -f dist/builder-debug.yml dist/builder-effective-config.yaml",
    "clean": "bash ../scripts/clean.sh",
    "build:drm": "make -C ../drm libdrm_client.so",
    "build:engine": "bash ../scripts/build-renderer.sh",
    "build:go": "bash ../scripts/build-engine.sh dist/resources -ldflags=\"-w -s\" -trimpath",
    "build:vlc": "bash ../scripts/bundle-vlc.sh",
    "dist:win": "powershell -ExecutionPolicy Bypass -File ../scripts/build-windows.ps1"
  },
  "desktopName": "adam.desktop",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "mp4box": "^2.4.1"
  },
  "build": {
    "appId": "io.github.silentone12725.Adam",
    "productName": "Adam",
    "copyright": "Copyright (c) Adam contributors",
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!**/*.map",
      "!test-*.html",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "../assets/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "AudioVideo",
      "description": "Adam, an Apple Music desktop client for Linux and Windows",
      "executableName": "adam",
      "artifactName": "adam.AppImage",
      "syncDesktopName": true,
      "mimeTypes": [
        "x-scheme-handler/adam"
      ],
      "extraResources": [
        {
          "from": "dist/resources/engine",
          "to": "engine"
        },
        {
          "from": "dist/resources/libdrm_client.so",
          "to": "libdrm_client.so"
        },
        {
          "from": "dist/resources/vlc",
          "to": "vlc"
        },
        {
          "from": "../third_party/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "adam-setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "dist/resources-win",
          "to": "."
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adam",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Adam",
        "schemes": [
          "adam"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "mpris-service": "^2.1.2",
    "x11": "^2.3.0"
  }
}
