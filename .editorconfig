# Editor settings shared by every contributor (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{json,yml,yaml,md,css,html,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated or vendored: keep as produced upstream.
[{electron/*-bundle.js,drm/native/{main.c,main.cpp,cmdline.*,hybris_stubs.c,drm_lib.*,import.h,hybris_types.h,cJSON.*,dobby.h},engine/**/*.pb.go}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
